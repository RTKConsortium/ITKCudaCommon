#ifndef itkCudaImageOperators_hcu
#define itkCudaImageOperators_hcu

// CUDA-only implementation header: include it from .cu files.
#include "itkCudaUtil.h"
#include "itkIntTypes.h"
#include "CudaCommonExport.h"
#include "itkCudaCommonConfiguration.h"

namespace itk
{
template <typename TOperation, typename TOutputPixel, typename... TInputPixels>
__global__ void
CudaImageOperationKernel(itk::SizeValueType numberOfPixels,
                         TOperation         operation,
                         TOutputPixel *     output,
                         const TInputPixels *... inputs)
{
  const itk::SizeValueType blockSize = blockDim.x;
  const itk::SizeValueType stride = gridDim.x * blockSize;
  for (itk::SizeValueType index = blockIdx.x * blockSize + threadIdx.x; index < numberOfPixels; index += stride)
  {
    output[index] = operation(inputs[index]...);
  }
}

/** Launch the shared CUDA kernel for unary or binary pixel-wise operations.
 * Operator .cu files supply a device lambda and one input buffer for unary
 * operations or two for binary operations. The concrete lambda type selects
 * the operation at compile time.
 */
template <typename TOperation, typename TOutputPixel, typename... TInputPixels>
void
LaunchCudaImageOperation(itk::SizeValueType numberOfPixels,
                         TOperation         operation,
                         TOutputPixel *     output,
                         const TInputPixels *... inputs)
{
  // Cap the grid so the launch is valid on every supported device. The kernel
  // uses a grid-stride loop to cover any remaining pixels.
  constexpr unsigned int       threadsPerBlock = 256;
  constexpr itk::SizeValueType maxGridBlocks = 65535;
  const itk::SizeValueType     totalBlocks = (numberOfPixels - 1) / threadsPerBlock + 1;
  const itk::SizeValueType     cappedBlocks = totalBlocks < maxGridBlocks ? totalBlocks : maxGridBlocks;
  const unsigned int           blocks = static_cast<unsigned int>(cappedBlocks);
  CudaImageOperationKernel<<<blocks, threadsPerBlock>>>(numberOfPixels, operation, output, inputs...);
  CUDA_CHECK(cudaGetLastError());
}
} // namespace itk

#endif
