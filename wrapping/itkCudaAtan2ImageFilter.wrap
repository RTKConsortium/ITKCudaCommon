itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaBinaryImageToImageFilter.h)
itk_wrap_include(itkAtan2ImageFilter.h)

itk_wrap_class("itk::CudaImageToImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${WRAP_ITK_REAL})
    itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}Atan2"
                        "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::Atan2ImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >"
    )
  endforeach()
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::CudaBinaryImageToImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${WRAP_ITK_REAL})
    itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}Atan2"
                        "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::Atan2ImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >"
    )
  endforeach()
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::CudaAtan2ImageFilter" POINTER)

unique(types "${WRAP_ITK_REAL}")
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${types})
    itk_wrap_template("CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}},${d}>")
  endforeach()
endforeach()

itk_end_wrap_class()
