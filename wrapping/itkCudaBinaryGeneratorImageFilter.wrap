itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaBinaryGeneratorImageFilter.h)
itk_wrap_include(itkAddImageFilter.h)
itk_wrap_include(itkSubtractImageFilter.h)
itk_wrap_include(itkMultiplyImageFilter.h)
itk_wrap_include(itkDivideImageFilter.h)
itk_wrap_include(itkDivideOrZeroOutImageFilter.h)

itk_wrap_class("itk::CudaBinaryGeneratorImageFilter" POINTER)

  # Instantiate with each concrete ITK parent used by the Cuda arithmetic filters
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}ADD" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::AddImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}SUB" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::SubtractImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}MUL" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::MultiplyImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}DIV" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::DivideImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}DOZ" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::DivideOrZeroOutImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

itk_end_wrap_class()
