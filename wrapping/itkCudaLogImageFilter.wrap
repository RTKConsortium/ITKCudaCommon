itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaUnaryImageToImageFilter.h)
itk_wrap_include(itkLogImageFilter.h)

foreach(
  cuda_base
  IN
  ITEMS
    itk::CudaImageToImageFilter
    itk::CudaUnaryImageToImageFilter
)
  itk_wrap_class("${cuda_base}" POINTER)

  unique(types "${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
      foreach(t ${types})
        itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}LOGF"
                            "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::LogImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >"
        )
      endforeach()
    endif()
  endforeach()

  itk_end_wrap_class()
endforeach()

itk_wrap_class("itk::CudaLogImageFilter" POINTER)

unique(types "${WRAP_ITK_SCALAR}")
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}},${d}>")
    endforeach()
  endif()
endforeach()

itk_end_wrap_class()
