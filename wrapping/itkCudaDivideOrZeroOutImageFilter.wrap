itk_wrap_include(itkCudaDivideOrZeroOutImageFilter.h)

itk_wrap_class("itk::CudaDivideOrZeroOutImageFilter" POINTER)

  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    if(d EQUAL 2 OR d EQUAL 3)
      foreach(t ${types})
        itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>")
      endforeach()
    endif()
  endforeach()

itk_end_wrap_class()
