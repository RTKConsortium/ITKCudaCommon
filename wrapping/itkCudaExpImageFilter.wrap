itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaUnaryImageToImageFilter.h)
itk_wrap_include(itkExpImageFilter.h)

foreach(
  cuda_base
  IN
  ITEMS
    itk::CudaImageToImageFilter
    itk::CudaUnaryImageToImageFilter
)
  itk_wrap_class("${cuda_base}" POINTER)

  unique(types "${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}EXPF"
                          "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::ExpImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >"
      )
    endforeach()
  endforeach()

  itk_end_wrap_class()
endforeach()

itk_wrap_class("itk::CudaExpImageFilter" POINTER)

unique(types "${WRAP_ITK_SCALAR}")
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${types})
    itk_wrap_template("CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}},${d}>")
  endforeach()
endforeach()

itk_end_wrap_class()
