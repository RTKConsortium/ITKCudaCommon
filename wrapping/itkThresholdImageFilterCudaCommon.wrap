itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkThresholdImageFilter.h)

itk_wrap_class("itk::ThresholdImageFilter" POINTER)

  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}"
                        "itk::CudaImage< ${ITKT_${t}}, ${d} >")
    endforeach()
  endforeach()

itk_end_wrap_class()
