itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaBinaryImageToImageFilter.h)
itk_wrap_include(itkMaskNegatedImageFilter.h)

itk_wrap_class("itk::CudaImageToImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${WRAP_ITK_SCALAR})
    set(masks "${CudaCommon_WRAP_MASK_TYPES};${t}")
    list(REMOVE_DUPLICATES masks)
    foreach(m ${masks})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}MaskNegatedCI${ITKM_${m}}${d}"
                          "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::MaskNegatedImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${m}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >"
      )
    endforeach()
  endforeach()
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::CudaBinaryImageToImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${WRAP_ITK_SCALAR})
    set(masks "${CudaCommon_WRAP_MASK_TYPES};${t}")
    list(REMOVE_DUPLICATES masks)
    foreach(m ${masks})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${m}}${d}MaskNegated"
                          "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${m}},${d}>, itk::MaskNegatedImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${m}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >"
      )
    endforeach()
  endforeach()
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::CudaMaskNegatedImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${WRAP_ITK_SCALAR})
    set(masks "${CudaCommon_WRAP_MASK_TYPES};${t}")
    list(REMOVE_DUPLICATES masks)
    foreach(m ${masks})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${m}}${d}"
                          "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${m}},${d}>"
      )
    endforeach()
  endforeach()
endforeach()
itk_end_wrap_class()
