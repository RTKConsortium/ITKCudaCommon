itk_wrap_include(itkCudaImage.h)

itk_wrap_class("itk::CudaSinImageFilter" POINTER)

	UNIQUE(types "${CudaCommon_WRAP_REAL_OPERATOR_TYPES}")
	foreach(d ${ITK_WRAP_IMAGE_DIMS})
		if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
			foreach(t ${types})
				itk_wrap_template("CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}},${d}>")
			endforeach()
		endif()
	endforeach()

itk_end_wrap_class()
