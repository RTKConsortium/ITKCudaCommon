itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaUnaryImageToImageFilter.h)
itk_wrap_include(itkSquareImageFilter.h)
itk_wrap_include(itkSqrtImageFilter.h)

itk_wrap_class("itk::CudaUnaryImageToImageFilter" POINTER)

  UNIQUE(types "${CudaCommonOperatorTypes}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
      foreach(t ${types})
        itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}SQF"
                          "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::SquareImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >")
      endforeach()
    endif()
  endforeach()

  UNIQUE(types "${CudaCommonOperatorTypes}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
      foreach(t ${types})
        itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}SQRTF"
                          "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::SqrtImageFilter<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >")
      endforeach()
    endif()
  endforeach()

itk_end_wrap_class()
