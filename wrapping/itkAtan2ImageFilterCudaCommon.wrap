itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkAtan2ImageFilter.h)

itk_wrap_class("itk::Atan2ImageFilter" POINTER)

foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(t ${WRAP_ITK_REAL})
    itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}"
                        "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>"
    )
  endforeach()
endforeach()

itk_end_wrap_class()
