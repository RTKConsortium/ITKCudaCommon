itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaImageToImageFilter.h)
itk_wrap_include(itkInPlaceImageFilter.h)
itk_wrap_include(itkAbsImageFilter.h)
itk_wrap_include(itkAcosImageFilter.h)
itk_wrap_include(itkAsinImageFilter.h)
itk_wrap_include(itkAtanImageFilter.h)
itk_wrap_include(itkBoundedReciprocalImageFilter.h)
itk_wrap_include(itkCosImageFilter.h)
itk_wrap_include(itkExpImageFilter.h)
itk_wrap_include(itkLogImageFilter.h)
itk_wrap_include(itkLog10ImageFilter.h)
itk_wrap_include(itkRoundImageFilter.h)
itk_wrap_include(itkSinImageFilter.h)
itk_wrap_include(itkSqrtImageFilter.h)
itk_wrap_include(itkSquareImageFilter.h)
itk_wrap_include(itkTanImageFilter.h)

itk_wrap_class("itk::CudaImageToImageFilter" POINTER)

  # Match CudaImage scalar instantiations
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR};${CudaCommon_WRAP_OPERATOR_TYPES}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>")
    endforeach()
  endforeach()

  # Match CudaImage vector/covariant instantiations
  UNIQUE(vector_types "${WRAP_ITK_VECTOR_REAL};${WRAP_ITK_COV_VECTOR_REAL}")
  foreach(c ${ITK_WRAP_VECTOR_COMPONENTS})
    foreach(d ${ITK_WRAP_IMAGE_DIMS})
      foreach(vt ${vector_types})
        itk_wrap_template("CI${ITKM_${vt}${c}}${d}CI${ITKM_${vt}${c}}${d}" "itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::CudaImage<${ITKT_${vt}${c}}, ${d}>")
      endforeach()
    endforeach()
  endforeach()

  # Instantiate with InPlaceImageFilter as parent for in-place CUDA filters
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR};${CudaCommon_WRAP_OPERATOR_TYPES}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}IPF" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::InPlaceImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

  UNIQUE(vector_types "${WRAP_ITK_VECTOR_REAL};${WRAP_ITK_COV_VECTOR_REAL}")
  foreach(c ${ITK_WRAP_VECTOR_COMPONENTS})
    foreach(d ${ITK_WRAP_IMAGE_DIMS})
      foreach(vt ${vector_types})
        itk_wrap_template("CI${ITKM_${vt}${c}}${d}CI${ITKM_${vt}${c}}${d}IPF" "itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::InPlaceImageFilter<itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::CudaImage<${ITKT_${vt}${c}}, ${d}> >")
      endforeach()
    endforeach()
  endforeach()


  # Parents that ITK wraps for every scalar pixel type.
  foreach(parent IN ITEMS
      "ABSF;itk::AbsImageFilter"
      "ACOSF;itk::AcosImageFilter"
      "ASINF;itk::AsinImageFilter"
      "BOUNDEDRECIPROCALF;itk::BoundedReciprocalImageFilter"
      "EXPF;itk::ExpImageFilter"
      "LOGF;itk::LogImageFilter"
      "LOG10F;itk::Log10ImageFilter"
      "SQF;itk::SquareImageFilter"
      "SQRTF;itk::SqrtImageFilter")
    list(GET parent 0 suffix)
    list(GET parent 1 parentType)
    UNIQUE(types "${CudaCommon_WRAP_OPERATOR_TYPES}")
    foreach(d ${ITK_WRAP_IMAGE_DIMS})
      if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
        foreach(t ${types})
          itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}${suffix}"
                            "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, ${parentType}<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >")
        endforeach()
      endif()
    endforeach()
  endforeach()

  # Parents that ITK wraps for real pixel types only.
  foreach(parent IN ITEMS
      "ATANF;itk::AtanImageFilter"
      "COSF;itk::CosImageFilter"
      "ROUNDF;itk::RoundImageFilter"
      "SINF;itk::SinImageFilter"
      "TANF;itk::TanImageFilter")
    list(GET parent 0 suffix)
    list(GET parent 1 parentType)
    UNIQUE(types "${CudaCommon_WRAP_REAL_OPERATOR_TYPES}")
    foreach(d ${ITK_WRAP_IMAGE_DIMS})
      if(d EQUAL 2 OR d EQUAL 3 OR d EQUAL 4)
        foreach(t ${types})
          itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}${suffix}"
                            "itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}>, ${parentType}<itk::CudaImage<${ITKT_${t}},${d}>, itk::CudaImage<${ITKT_${t}},${d}> >")
        endforeach()
      endif()
    endforeach()
  endforeach()

itk_end_wrap_class()
