itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaImageToImageFilter.h)
itk_wrap_include(itkInPlaceImageFilter.h)
itk_wrap_include(itkSquareImageFilter.h)
itk_wrap_include(itkThresholdImageFilter.h)
itk_wrap_include(itkAddImageFilter.h)
itk_wrap_include(itkSubtractImageFilter.h)
itk_wrap_include(itkMultiplyImageFilter.h)
itk_wrap_include(itkDivideImageFilter.h)
itk_wrap_include(itkDivideOrZeroOutImageFilter.h)

itk_wrap_class("itk::CudaImageToImageFilter" POINTER)

  # Match CudaImage scalar instantiations
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>")
    endforeach()
  endforeach()

  # Match CudaImage vector/covariant instantiations
  UNIQUE(vector_types "${WRAP_ITK_VECTOR_REAL};${WRAP_ITK_COV_VECTOR_REAL}")
  foreach(c ${ITK_WRAP_VECTOR_COMPONENTS})
    foreach(d ${ITK_WRAP_IMAGE_DIMS})
      foreach(vt ${vector_types})
        itk_wrap_template("CI${ITKM_${vt}${c}}${d}CI${ITKM_${vt}${c}}${d}" "itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::CudaImage<${ITKT_${vt}${c}}, ${d}>")
      endforeach()
    endforeach()
  endforeach()

  # Instantiate with InPlaceImageFilter as parent for in-place CUDA filters
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}IPF" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::InPlaceImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

  UNIQUE(vector_types "${WRAP_ITK_VECTOR_REAL};${WRAP_ITK_COV_VECTOR_REAL}")
  foreach(c ${ITK_WRAP_VECTOR_COMPONENTS})
    foreach(d ${ITK_WRAP_IMAGE_DIMS})
      foreach(vt ${vector_types})
        itk_wrap_template("CI${ITKM_${vt}${c}}${d}CI${ITKM_${vt}${c}}${d}IPF" "itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::InPlaceImageFilter<itk::CudaImage<${ITKT_${vt}${c}}, ${d}>, itk::CudaImage<${ITKT_${vt}${c}}, ${d}> >")
      endforeach()
    endforeach()
  endforeach()

  # Instantiate with SquareImageFilter as parent for CudaSquareImageFilter
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}SQF" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::SquareImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

  # Instantiate with the concrete ITK parents used by the Cuda arithmetic filters
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}THR" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::ThresholdImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}ADD" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::AddImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}SUB" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::SubtractImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}MUL" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::MultiplyImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}DIV" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::DivideImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}DOZ" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::DivideOrZeroOutImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

itk_end_wrap_class()
