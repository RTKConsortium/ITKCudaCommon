itk_wrap_include(itkCudaImage.h)
itk_wrap_include(itkCudaUnaryGeneratorImageFilter.h)
itk_wrap_include(itkSquareImageFilter.h)
itk_wrap_include(itkThresholdImageFilter.h)

itk_wrap_class("itk::CudaUnaryGeneratorImageFilter" POINTER)

  # Instantiate with SquareImageFilter as parent for CudaSquareImageFilter
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}SQF" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::SquareImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

  # Instantiate with ThresholdImageFilter as parent for CudaThresholdImageFilter
  UNIQUE(types "UC;UL;${WRAP_ITK_SCALAR}")
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    foreach(t ${types})
      itk_wrap_template("CI${ITKM_${t}}${d}CI${ITKM_${t}}${d}THR" "itk::CudaImage<${ITKT_${t}}, ${d}>, itk::CudaImage<${ITKT_${t}}, ${d}>, itk::ThresholdImageFilter<itk::CudaImage<${ITKT_${t}}, ${d}> >")
    endforeach()
  endforeach()

itk_end_wrap_class()
